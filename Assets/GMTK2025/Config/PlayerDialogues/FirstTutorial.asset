%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a740502731dab025bdeccf416ca83a4, type: 3}
  m_Name: FirstTutorial
  m_EditorClassIdentifier: 
  <ShouldBlockInteraction>k__BackingField: 0
  <ShouldBeSkippable>k__BackingField: 1
  <ChainType>k__BackingField: 1
  <Dialogues>k__BackingField:
  - <Message>k__BackingField: "Alright kid, job\u2019s easy: you only have to make
      ships and satellites NOT crash into each other! Too many crashes and BOOM,
      you'll be fired."
    <IconOverride>k__BackingField: {fileID: 0}
  - <Message>k__BackingField: "To start the day, there won\u2019t be too many of
      them, so use that time to get acclimated. As the day goes on, more will request
      to join orbit, so just pick which one you want."
    <IconOverride>k__BackingField: {fileID: 21300000, guid: fe40fe75d7474bf45aba5790721e8c11, type: 3}
  - <Message>k__BackingField: 'Each and every ship and satellite wants to be on a
      specific orbit.

      The preferred orbit will be highlighted in yellow when
      you hover over the spaceship.

'
    <IconOverride>k__BackingField: {fileID: 0}
  - <Message>k__BackingField: "Ships will usually make you more money, but they\u2019ll
      leave orbit after a while.\r\nSatellites might make a little less, but they\u2019ll
      stay until something crashes into them.\r"
    <IconOverride>k__BackingField: {fileID: 21300000, guid: fe40fe75d7474bf45aba5790721e8c11, type: 3}
  - <Message>k__BackingField: "If you make enough money, you can buy upgrades for
      the system that will make managing all this a little easier. \r\nYou can always
      check the bottom right of your screen to see how much upgrades cost.\r\n"
    <IconOverride>k__BackingField: {fileID: 21300000, guid: 6b1cb82faed95ba4b87da762c903a1e8, type: 3}
  - <Message>k__BackingField: "Good luck out there kid, you\u2019re gonna need it.
      Stay employed as long as you can, and see just how much money you can make
      for Spaceloop Inc!"
    <IconOverride>k__BackingField: {fileID: 21300000, guid: 5b5b94519563f524aa7cb9f0658a1a7d, type: 3}
